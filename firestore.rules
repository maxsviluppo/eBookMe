rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated and matches userId
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // User profile document
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // User's custom and uploaded ebooks
      match /books/{bookId} {
        allow read, write: if isOwner(userId);
      }

      // User reading progress
      match /progress/{bookId} {
        allow read, write: if isOwner(userId);
      }

      // User bookmarks
      match /bookmarks/{bookmarkId} {
        allow read, write: if isOwner(userId);
      }

      // User highlights & annotations
      match /highlights/{highlightId} {
        allow read, write: if isOwner(userId);
      }

      // User reader settings
      match /settings/{settingDoc} {
        allow read, write: if isOwner(userId);
      }
    }

    // Public books / community catalog (optional read-only)
    match /public_books/{bookId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
